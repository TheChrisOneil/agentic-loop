#!/usr/bin/env bash
# A stand-in for the claude CLI, used only by tests/repair-path.sh.
# First call: emit a design that breaks four rules. Second call (the prompt now carries the
# validator's findings): emit a design that passes. That is the contract the repair loop relies on.
PROMPT=$(cat)
if printf '%s' "$PROMPT" | grep -q "Your previous attempt was rejected"; then
  cat "$(dirname "$0")/../fixtures/good.design"
else
  cat "$(dirname "$0")/../fixtures/bad.design"
fi
